SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BOT_MODE=paper
TRADING_ENABLED=false

# Startup guard: wait until IB API accepts handshake before launching bot loop
IB_STARTUP_WAIT_ENABLED=1
IB_STARTUP_WAIT_TIMEOUT_SECONDS=180
IB_STARTUP_WAIT_PROBE_INTERVAL_SECONDS=2
IB_STARTUP_WAIT_CONNECT_TIMEOUT_SECONDS=5
IB_STARTUP_WAIT_CLIENT_ID=199

# FX Funds Guard - Pre-check currency balance before FX orders
FX_FUNDS_GUARD_ENABLED=1      # Set to 0 to disable funds guard entirely
FX_FUNDS_BUFFER=0.02          # Safety buffer for BUY orders (2%)
FX_QTY_STEP=100               # Round quantity to nearest step
FX_MIN_IDEALPRO=20000         # IB minimum for IDEALPRO routing
FX_MIN_TRADE_QTY=5000         # Minimum trade size (skip smaller)
FX_ALLOW_ODD_LOTS=true        # Allow below IDEALPRO min (warning 399)
FX_FUNDS_POLICY=auto_reduce   # Policy: auto_reduce or skip
