# IBKR Credentials
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password

# Optional: TOTP secret for 2FA (base32 encoded)
# If you use IBKR mobile app for 2FA, leave this empty
# and enter the code manually via VNC on first login
TWS_TOTP_SECRET=

# VNC password for remote access (default: ibgateway)
VNC_PASSWORD=your_vnc_password
